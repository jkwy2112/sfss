limit_req zone=sfss_api burst=100 nodelay;
proxy_pass https://blue-in-sfss.internal:8443;
proxy_ssl_server_name on;
proxy_ssl_name blue-in-sfss.internal;
proxy_ssl_certificate /etc/sfss/tls/green-gateway-client.pem;
proxy_ssl_certificate_key /etc/sfss/tls/green-gateway-client-key.pem;
proxy_ssl_trusted_certificate /etc/sfss/tls/blue-ca.pem;
proxy_ssl_crl /etc/sfss/tls/blue-ca.crl.pem;
proxy_ssl_verify on;
proxy_ssl_verify_depth 2;
proxy_http_version 1.1;
proxy_request_buffering off;
proxy_buffering off;
proxy_read_timeout 3600s;
proxy_send_timeout 3600s;
proxy_set_header Host blue-in-sfss.internal;
proxy_set_header X-SFSS-Zone green;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Request-ID $request_id;
proxy_set_header Connection "";
