SFSS_ENVIRONMENT=production
# Replace with the immutable release/build identifier and exact target runtime.
SFSS_RELEASE_ID=REPLACE_WITH_SIGNED_RELEASE_ID
SFSS_EXPECTED_PYTHON_VERSION=REPLACE_WITH_MAJOR_MINOR_PATCH
# Populate after offline initialization using `sfss-admin config-fingerprint`.
SFSS_EXPECTED_CONFIG_SHA256=REPLACE_WITH_64_HEX_DIGEST
SFSS_DATA_DIR=/srv/sfss
SFSS_AUTH_BACKEND=ldap
SFSS_LDAP_URI=ldaps://ad.example.internal:636
SFSS_LDAP_BASE_DN=dc=example,dc=internal
SFSS_LDAP_USER_TEMPLATE=userPrincipalName={username},dc=example,dc=internal
SFSS_LDAP_CA_FILE=/etc/sfss/pki/ldap-ca.pem
SFSS_LDAP_CA_SHA256=REPLACE_WITH_64_HEX_SHA256
SFSS_ALLOW_BASIC_AUTH=false
SFSS_ALLOW_LOCAL_APPROVAL=false
# The blue core talks only to this internal mTLS relay. The relay—not SFSS—owns
# the public WeCom CorpSecret and Tencent API/callback implementation.
SFSS_APPROVAL_RELAY_URL=https://approval-relay.yellow.example.internal/v1/requests
SFSS_APPROVAL_RELAY_CA_FILE=/etc/sfss/pki/approval-relay-ca.pem
SFSS_APPROVAL_RELAY_CLIENT_CERT=/etc/sfss/pki/approval-relay-client.pem
SFSS_APPROVAL_RELAY_CLIENT_KEY=/etc/sfss/pki/approval-relay-client-key.pem
SFSS_APPROVAL_RELAY_CA_SHA256=REPLACE_WITH_64_HEX_SHA256
SFSS_APPROVAL_RELAY_CLIENT_CERT_SHA256=REPLACE_WITH_64_HEX_SHA256
# The secrets manager must materialize independent mode-0600 files.
SFSS_APPROVAL_RELAY_SUBMIT_HMAC_KEY_FILE=/run/credentials/sfss/approval-submit-hmac
SFSS_APPROVAL_RELAY_CALLBACK_HMAC_KEY_FILE=/run/credentials/sfss/approval-callback-hmac
SFSS_APPROVAL_RELAY_TIMEOUT_SECONDS=10
SFSS_APPROVAL_CALLBACK_MAX_SKEW_SECONDS=300
SFSS_BOOTSTRAP_ADMINS=sfss-admin@example.internal
SFSS_DEV_TOKENS_ENABLED=false
SFSS_LOCAL_CREDENTIALS=
SFSS_SCANNERS=clamav,yara
SFSS_CLAMAV_HOST=127.0.0.1
SFSS_CLAMAV_PORT=3310
SFSS_CLAMAV_STREAM_MAX_BYTES=2147483648
SFSS_YARA_RULES=/etc/sfss/rules/production.yar
# SHA-256 of the reviewed immutable rule bundle. Recalculate only through
# change control; startup and the live data-plane gate detect replacement.
SFSS_YARA_RULES_SHA256=REPLACE_WITH_64_HEX_SHA256
SFSS_TRUSTED_ZONE_PROXY_CIDRS=127.0.0.1/32,::1/128
SFSS_ADMIN_SOURCE_CIDRS=10.20.10.0/24
SFSS_REQUIRE_TRUSTED_PROXY=true
SFSS_REQUIRE_FORWARDED_HTTPS=true
# The secrets manager must materialize a mode-0600 file. Production rejects a raw value.
SFSS_MANIFEST_HMAC_KEY_FILE=/run/credentials/sfss/manifest-hmac
SFSS_MAX_UPLOAD_BYTES=2147483648
SFSS_MAX_ACTIVE_UPLOADS_PER_USER=4
SFSS_MAX_STAGED_BYTES_PER_PROJECT=8589934592
# Keep this much physical capacity unavailable to uploads. Size it above WAL,
# scanner scratch, audit growth, and emergency operating headroom.
SFSS_MIN_FREE_BYTES=107374182400
SFSS_MULTIPART_CHUNK_BYTES=33554432
SFSS_UPLOAD_SESSION_TTL_SECONDS=86400
# Human sessions are bound to the issuing green/red/admin entrance.
SFSS_SESSION_TTL_SECONDS=3600
SFSS_SESSION_IDLE_SECONDS=900
SFSS_MAX_SESSIONS_PER_USER=3
SFSS_SERVICE_TOKEN_MAX_TTL_SECONDS=2592000
# Defense in depth behind Nginx: bound slow headers, request/download I/O, and
# the number of accepted requests that may own a core worker thread.
SFSS_REQUEST_HEADER_TIMEOUT_SECONDS=15
SFSS_REQUEST_IO_TIMEOUT_SECONDS=3600
SFSS_MAX_REQUEST_WORKERS=128
SFSS_SCAN_TIMEOUT_SECONDS=1800
SFSS_JOB_WORKERS=4
SFSS_JOB_LEASE_SECONDS=1800
SFSS_JOB_MAX_ATTEMPTS=3
SFSS_RETENTION_SECONDS=604800
SFSS_PURGE_GRACE_SECONDS=86400
